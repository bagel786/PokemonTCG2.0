{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-instrumentation-run-config.schema.json",
  "title": "Frozen Pokemon instrumentation runtime controls",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "entrypoint", "entrypoint_payload", "target_cpus",
    "worker_timeout_s", "require_linux_affinity", "thread_env",
    "platform_expectations", "resource_profile", "test_mode", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "pokemon-instrumentation-run-config-1.0.0"},
    "entrypoint": {"type": "string", "minLength": 1},
    "entrypoint_payload": {"type": "object"},
    "target_cpus": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "worker_timeout_s": {"type": "number", "exclusiveMinimum": 0},
    "require_linux_affinity": {"type": "boolean"},
    "thread_env": {"type": "object", "additionalProperties": {"type": "string"}},
    "platform_expectations": {"type": "object", "additionalProperties": {"type": "string"}},
    "resource_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["condition", "worker_count", "target_cpus", "chunk_iterations", "readiness_timeout_s"],
      "properties": {
        "condition": {"const": "idle"},
        "worker_count": {"const": 0},
        "target_cpus": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "chunk_iterations": {"const": 50000},
        "readiness_timeout_s": {"const": 15.0}
      }
    },
    "test_mode": {"type": "boolean"},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
