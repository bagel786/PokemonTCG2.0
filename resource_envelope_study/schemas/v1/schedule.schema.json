{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/schedule.schema.json",
  "title": "Resource-envelope schedule manifest v1",
  "type": "object",
  "required": ["schema_version", "config", "design", "rows", "content_hash"],
  "properties": {
    "schema_version": {"const": "schedule-manifest-1.0.0"},
    "config": {"type": "object"},
    "design": {"type": "object"},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "phase",
          "case_id",
          "block_id",
          "agent_id",
          "budget_mode",
          "load_condition",
          "lifecycle",
          "physical_seat",
          "play_order",
          "environment_seed",
          "agent_seed",
          "schedule_seed",
          "load_seed",
          "load_batch_id",
          "load_period_order",
          "lifecycle_pair_id",
          "sequence_pair_id",
          "session_bundle_id",
          "lifecycle_id",
          "process_instance_id",
          "sequence_index",
          "execution_index",
          "requested_budget_ns",
          "requested_work_units"
        ],
        "properties": {
          "schema_version": {"const": "schedule-row-1.0.0"},
          "phase": {"enum": ["smoke", "pilot", "final"]},
          "case_id": {"type": "string", "minLength": 1},
          "block_id": {"type": "string", "minLength": 1},
          "agent_id": {"type": "string", "minLength": 1},
          "budget_mode": {"enum": ["wall_clock", "fixed_work"]},
          "load_condition": {"enum": ["idle", "loaded"]},
          "lifecycle": {"enum": ["fresh", "persistent"]},
          "physical_seat": {"enum": [0, 1]},
          "play_order": {"enum": [0, 1]},
          "environment_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "agent_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "schedule_seed": {"type": "integer", "minimum": 0},
          "load_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
          "load_batch_id": {"type": "string", "minLength": 1},
          "load_period_order": {"enum": ["idle_then_loaded", "loaded_then_idle"]},
          "lifecycle_pair_id": {"type": "string", "minLength": 1},
          "sequence_pair_id": {"type": "string", "minLength": 1},
          "session_bundle_id": {"type": "string", "minLength": 1},
          "lifecycle_id": {"type": "string", "minLength": 1},
          "process_instance_id": {"type": "string", "minLength": 1},
          "sequence_index": {"type": "integer", "minimum": 0},
          "execution_index": {"type": "integer", "minimum": 0},
          "requested_budget_ns": {"type": ["integer", "null"], "minimum": 0},
          "requested_work_units": {"type": ["integer", "null"], "minimum": 0}
        }
      }
    }
  }
}
