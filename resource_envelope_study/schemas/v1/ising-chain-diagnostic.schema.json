{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ising-chain-diagnostic.schema.json",
  "title": "Ising independent-chain convergence/reference diagnostic",
  "type": "object",
  "required": [
    "schema_version", "panel_kind", "lattice_size", "temperature", "coupling_j",
    "burn_in_sweeps", "observable", "chain_count", "draws_per_chain",
    "seed_set_hash", "diagnostic_plan_row_hash", "sample_mean", "sample_standard_deviation", "split_r_hat",
    "effective_sample_size", "mcse", "exact_reference",
    "reference_absolute_error", "record_hash"
  ],
  "properties": {
    "schema_version": {"const": "ising-chain-diagnostic-1.0.0"},
    "panel_kind": {"enum": ["main_convergence", "exact_reference"]},
    "lattice_size": {"type": "integer", "minimum": 2},
    "temperature": {"enum": [1.5, 2.269185314213022, 3.5]},
    "coupling_j": {"type": "number", "exclusiveMinimum": 0},
    "burn_in_sweeps": {"type": "integer", "minimum": 0},
    "observable": {"enum": ["absolute_magnetization_per_spin", "energy_per_spin"]},
    "chain_count": {"type": "integer", "minimum": 4},
    "draws_per_chain": {"type": "integer", "minimum": 4},
    "seed_set_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "diagnostic_plan_row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sample_mean": {"type": "number"},
    "sample_standard_deviation": {"type": "number", "minimum": 0},
    "split_r_hat": {"type": "number", "minimum": 0},
    "effective_sample_size": {"type": "number", "exclusiveMinimum": 0},
    "mcse": {"type": "number", "minimum": 0},
    "exact_reference": {"type": ["number", "null"]},
    "reference_absolute_error": {"type": ["number", "null"], "minimum": 0},
    "record_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
