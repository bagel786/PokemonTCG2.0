{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/power-simulation.schema.json",
  "title": "Exact-scheduler clustered power simulation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "power_version",
    "input_lock_hash",
    "inputs",
    "powered_estimand",
    "inference_unit",
    "assignment_hierarchy",
    "multiplicity_method",
    "two_sided_member_alpha",
    "planning_test",
    "attrition_handling",
    "candidates",
    "score_endpoint_candidate_blocks_per_cell",
    "recommended_blocks_per_cell",
    "full_confirmatory_family_power_established",
    "freeze_authorized",
    "disposition",
    "not_powered_by_this_artifact",
    "limitation",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "clustered-scheduler-power-1.0.0"},
    "power_version": {"const": "clustered-scheduler-power-1.0.0"},
    "input_lock_hash": {"$ref": "#/$defs/hash"},
    "inputs": {"type": "object"},
    "powered_estimand": {"const": "equal_agent_paired_score_load_effect_at_10pp"},
    "inference_unit": {"const": "complete_matched_block"},
    "assignment_hierarchy": {"const": "load_batch_to_common_session_bundle_to_complete_block"},
    "multiplicity_method": {"const": "bonferroni_over_10_confirmatory_estimands"},
    "two_sided_member_alpha": {"const": 0.005},
    "planning_test": {"const": "load-batch-cluster-robust normal interval"},
    "attrition_handling": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "score_endpoint_candidate_blocks_per_cell": {"type": ["integer", "null"], "minimum": 1},
    "recommended_blocks_per_cell": {"type": ["integer", "null"], "minimum": 1},
    "full_confirmatory_family_power_established": {"const": false},
    "freeze_authorized": {"const": false},
    "disposition": {"const": "NARROW_OR_EXTEND"},
    "not_powered_by_this_artifact": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "limitation": {"type": "string", "minLength": 1},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "candidate": {
      "type": "object",
      "required": [
        "block_count",
        "schedule_content_hash",
        "scheduled_case_count",
        "persistent_session_count",
        "detections",
        "simulation_replicates",
        "valid_replicates",
        "unconditional_power",
        "power_monte_carlo_95_interval",
        "median_retained_load_batches",
        "median_retained_blocks",
        "projected_runtime_hours_including_expected_replacement",
        "available_acquisition_hours_after_analysis_reserve",
        "runtime_feasible",
        "meets_score_endpoint_power_and_runtime",
        "meets_power_and_runtime"
      ],
      "properties": {
        "block_count": {"type": "integer", "minimum": 1},
        "schedule_content_hash": {"$ref": "#/$defs/hash"},
        "scheduled_case_count": {"type": "integer", "minimum": 1},
        "persistent_session_count": {"type": "integer", "minimum": 1},
        "detections": {"type": "integer", "minimum": 0},
        "simulation_replicates": {"type": "integer", "minimum": 100},
        "valid_replicates": {"type": "integer", "minimum": 0},
        "unconditional_power": {"type": "number", "minimum": 0, "maximum": 1},
        "power_monte_carlo_95_interval": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "median_retained_load_batches": {"type": "number", "minimum": 0},
        "median_retained_blocks": {"type": "number", "minimum": 0},
        "projected_runtime_hours_including_expected_replacement": {"type": "number", "minimum": 0},
        "available_acquisition_hours_after_analysis_reserve": {"type": "number", "minimum": 0},
        "runtime_feasible": {"type": "boolean"},
        "meets_score_endpoint_power_and_runtime": {"type": "boolean"},
        "meets_power_and_runtime": {"const": false}
      },
      "additionalProperties": false
    }
  }
}
