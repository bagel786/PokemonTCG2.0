{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "load-period-journal.schema.json",
  "title": "Crash-durable completed load-period evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment",
    "manifest_content_hash",
    "phase",
    "load_batch_id",
    "load_condition",
    "period_case_ids",
    "case_result_hashes",
    "resource_episode_hash",
    "case_results",
    "resource_episode",
    "terminal_status",
    "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "load-period-journal-1.0.0"},
    "experiment": {"enum": ["pokemon", "ising"]},
    "manifest_content_hash": {"$ref": "#/$defs/sha256"},
    "phase": {"enum": ["smoke", "pilot", "final"]},
    "load_batch_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"},
    "load_condition": {"enum": ["idle", "loaded"]},
    "period_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "case_result_hashes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sha256"}
    },
    "resource_episode_hash": {"$ref": "#/$defs/sha256"},
    "case_results": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "resource_episode": {"type": "object"},
    "terminal_status": {"const": "period_complete"},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
