{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/state-capture-manifest.schema.json",
  "title": "Isolated state-capture manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "bank_id", "purpose", "preallocation_content_hash",
    "preallocation_file_sha256", "requests", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "state-capture-manifest-1.0.0"},
    "bank_id": {
      "enum": [
        "deadline_calibration", "fixed_work_calibration", "repeatability_pilot",
        "repeatability_final", "repeatability_reserve"
      ]
    },
    "purpose": {"enum": ["calibration", "repeatability"]},
    "preallocation_content_hash": {"$ref": "#/$defs/hash"},
    "preallocation_file_sha256": {"$ref": "#/$defs/hash"},
    "requests": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
