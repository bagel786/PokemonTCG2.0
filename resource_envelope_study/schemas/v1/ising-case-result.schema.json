{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ising-case-result.schema.json",
  "title": "Ising resource-envelope case result",
  "type": "object",
  "required": [
    "schema_version", "case_id", "manifest_row_hash", "chain_id", "chain_seed_hash",
    "temperature_index", "temperature", "lattice_size", "coupling_j",
    "burn_in_sweeps", "burn_in_in_measurement", "budget_mode",
    "requested_budget_ns", "requested_sweeps", "completed_sweeps",
    "measurement_attempted_flips", "magnetization_per_spin",
    "absolute_magnetization_per_spin", "energy_per_spin", "initial_state_hash",
    "final_state_hash", "load_condition", "load_batch_id", "load_seed",
    "load_period_order", "resource_profile_contract_hash", "instrumentation_enabled", "worker_pid",
    "search_wall_ns", "process_cpu_ns", "overshoot_ns", "cleanup_succeeded",
    "terminal_status", "error_type", "error_message", "decision_record"
  ],
  "properties": {
    "schema_version": {"const": "ising-case-result-1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "manifest_row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chain_id": {"type": "string", "minLength": 1},
    "chain_seed_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "temperature_index": {"type": "integer", "minimum": 0, "maximum": 2},
    "temperature": {"enum": [1.5, 2.269185314213022, 3.5]},
    "lattice_size": {"type": "integer", "minimum": 2},
    "coupling_j": {"type": "number", "exclusiveMinimum": 0},
    "burn_in_sweeps": {"type": "integer", "minimum": 0},
    "burn_in_in_measurement": {"const": false},
    "budget_mode": {"enum": ["wall_clock", "fixed_sweeps"]},
    "requested_budget_ns": {"type": ["integer", "null"], "minimum": 1},
    "requested_sweeps": {"type": ["integer", "null"], "minimum": 1},
    "completed_sweeps": {"type": "integer", "minimum": 0},
    "measurement_attempted_flips": {"type": "integer", "minimum": 0},
    "magnetization_per_spin": {"type": ["number", "null"], "minimum": -1, "maximum": 1},
    "absolute_magnetization_per_spin": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "energy_per_spin": {"type": ["number", "null"]},
    "initial_state_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "final_state_hash": {"type": ["string", "null"]},
    "load_condition": {"enum": ["idle", "loaded"]},
    "load_batch_id": {"type": "string", "minLength": 1},
    "load_seed": {"type": "integer", "minimum": 0},
    "load_period_order": {"enum": ["idle_then_loaded", "loaded_then_idle"]},
    "resource_profile_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "instrumentation_enabled": {"type": "boolean"},
    "worker_pid": {"type": "integer", "minimum": 1},
    "search_wall_ns": {"type": "integer", "minimum": 0},
    "process_cpu_ns": {"type": "integer", "minimum": 0},
    "overshoot_ns": {"type": "integer", "minimum": 0},
    "cleanup_succeeded": {"type": "boolean"},
    "terminal_status": {"type": "string", "minLength": 1},
    "error_type": {"type": "string"},
    "error_message": {"type": "string"},
    "decision_record": {"type": "object"}
  }
}
