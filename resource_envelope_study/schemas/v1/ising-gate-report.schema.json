{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ising-gate-report.schema.json",
  "title": "APS-only Ising companion gate report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "decision", "scientific_scope", "pokemon_scope_effect",
    "pokemon_rescue_allowed", "thresholds", "checks", "reasons",
    "interpretation", "report_hash"
  ],
  "properties": {
    "schema_version": {"const": "ising-aps-gate-1.0.0"},
    "decision": {"enum": ["APS_GO", "APS_NO_GO"]},
    "scientific_scope": {"const": "open_ising_companion_only"},
    "pokemon_scope_effect": {"const": "none"},
    "pokemon_rescue_allowed": {"const": false},
    "thresholds": {"type": "object"},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "passed", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "passed": {"type": "boolean"},
          "evidence": {"type": "object"}
        }
      }
    },
    "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "interpretation": {"type": "string", "minLength": 1},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
