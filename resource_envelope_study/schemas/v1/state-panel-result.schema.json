{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/state-panel-result.schema.json",
  "title": "Terminal state-panel result v1",
  "type": "object",
  "required": [
    "schema_version", "case_id", "manifest_content_hash", "schedule_row",
    "state_artifact_sha256", "budget_mode", "terminal_status", "eligible",
    "completed_work_units", "search_wall_ns", "overshoot_ns", "state_hash",
    "selected_action_hash", "cleanup_succeeded", "warmup_steps_completed",
    "warmup_consumed_sha256", "warmup_replay_sha256", "artifact_sha256"
  ],
  "properties": {
    "schema_version": {"const": "state-panel-result-1.0.0"},
    "case_id": {"type": "string", "minLength": 1},
    "manifest_content_hash": {"$ref": "#/$defs/hash"},
    "schedule_row": {"type": "object"},
    "state_artifact_sha256": {"$ref": "#/$defs/hash"},
    "budget_mode": {"enum": ["wall_clock", "fixed_work"]},
    "terminal_status": {"enum": ["ok", "deadline_no_work", "infrastructure_error"]},
    "eligible": {"type": "boolean"},
    "completed_work_units": {"type": "integer", "minimum": 0},
    "search_wall_ns": {"type": "integer", "minimum": 0},
    "overshoot_ns": {"type": "integer", "minimum": 0},
    "state_hash": {"$ref": "#/$defs/hash"},
    "selected_action_hash": {"$ref": "#/$defs/hash"},
    "cleanup_succeeded": {"type": "boolean"},
    "warmup_steps_completed": {"type": "integer", "minimum": 0},
    "warmup_consumed_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "warmup_replay_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "artifact_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
