{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/state-panel-batch-commit.schema.json",
  "title": "Atomic state-panel batch commit v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "group_kind", "group_id", "manifest_content_hash",
    "run_config_file_sha256", "batch_status", "case_ids", "result_hashes",
    "episode_hashes", "content_hash"
  ],
  "properties": {
    "schema_version": {"const": "state-panel-batch-commit-1.0.0"},
    "group_kind": {"enum": ["paired_load_batch", "calibration_case"]},
    "group_id": {"type": "string", "minLength": 1},
    "manifest_content_hash": {"$ref": "#/$defs/hash"},
    "run_config_file_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "batch_status": {"enum": ["scientific_complete", "infrastructure_invalid"]},
    "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "result_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}},
    "episode_hashes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/hash"}},
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
