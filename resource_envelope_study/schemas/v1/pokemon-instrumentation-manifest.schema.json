{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pokemon-instrumentation-manifest.schema.json",
  "title": "Frozen native Pokemon instrumentation-overhead pilot manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "config", "design", "pairs", "content_hash"],
  "properties": {
    "schema_version": {"const": "pokemon-instrumentation-manifest-1.0.0"},
    "config": {
      "type": "object",
      "required": [
        "phase", "master_seed", "pair_count", "agents", "fixed_work_by_agent",
        "frozen_states", "run_config_file", "run_config_file_sha256",
        "run_config_content_hash", "state_selection_bank_name",
        "state_selection_bank_file", "state_selection_bank_file_sha256",
        "state_selection_bank_content_hash", "pilot_gate_file", "pilot_gate_file_sha256",
        "gate_specification"
      ],
      "properties": {
        "phase": {"const": "pilot"},
        "master_seed": {"type": "integer", "minimum": 0},
        "pair_count": {"type": "integer", "minimum": 20, "multipleOf": 2},
        "agents": {
          "const": ["one_ply_value_v1", "flat_rollout_v1", "puct_tree_v1"]
        },
        "fixed_work_by_agent": {"type": "object", "minProperties": 3, "maxProperties": 3},
        "frozen_states": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["state_id", "source_game_id", "state_file", "state_file_sha256"],
            "properties": {
              "state_id": {"type": "string", "minLength": 1},
              "source_game_id": {"type": "string", "minLength": 1},
              "state_file": {"type": "string", "minLength": 1},
              "state_file_sha256": {"$ref": "#/$defs/hash"}
            }
          }
        },
        "run_config_file": {"type": "string", "minLength": 1},
        "run_config_file_sha256": {"$ref": "#/$defs/hash"},
        "run_config_content_hash": {"$ref": "#/$defs/hash"},
        "state_selection_bank_name": {"type": ["string", "null"]},
        "state_selection_bank_file": {"type": ["string", "null"]},
        "state_selection_bank_file_sha256": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "state_selection_bank_content_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "pilot_gate_file": {"type": "string", "minLength": 1},
        "pilot_gate_file_sha256": {"$ref": "#/$defs/hash"},
        "gate_specification": {"type": "object"}
      }
    },
    "design": {"type": "object"},
    "pairs": {
      "type": "array", "minItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["pair_id", "pair_index", "instrumentation_order", "rows", "pair_plan_hash"],
        "properties": {
          "pair_id": {"type": "string", "minLength": 1},
          "pair_index": {"type": "integer", "minimum": 0},
          "instrumentation_order": {"enum": ["off_then_on", "on_then_off"]},
          "rows": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/row"}},
          "pair_plan_hash": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "content_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema_version", "case_id", "pair_id", "pair_index", "execution_index",
        "execution_position", "instrumentation_order", "instrumentation_enabled",
        "state_id", "source_game_id", "state_file", "state_file_sha256",
        "agent_id", "agent_seed", "requested_work_units", "budget_mode",
        "load_condition", "lifecycle"
      ],
      "properties": {
        "schema_version": {"const": "pokemon-instrumentation-row-1.0.0"},
        "case_id": {"type": "string", "minLength": 1},
        "pair_id": {"type": "string", "minLength": 1},
        "pair_index": {"type": "integer", "minimum": 0},
        "execution_index": {"type": "integer", "minimum": 0},
        "execution_position": {"type": "integer", "minimum": 0, "maximum": 1},
        "instrumentation_order": {"enum": ["off_then_on", "on_then_off"]},
        "instrumentation_enabled": {"type": "boolean"},
        "state_id": {"type": "string", "minLength": 1},
        "source_game_id": {"type": "string", "minLength": 1},
        "state_file": {"type": "string", "minLength": 1},
        "state_file_sha256": {"$ref": "#/$defs/hash"},
        "agent_id": {"enum": ["one_ply_value_v1", "flat_rollout_v1", "puct_tree_v1"]},
        "agent_seed": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "requested_work_units": {"type": "integer", "minimum": 1},
        "budget_mode": {"const": "fixed_work"},
        "load_condition": {"const": "idle"},
        "lifecycle": {"const": "fresh"}
      }
    }
  }
}
