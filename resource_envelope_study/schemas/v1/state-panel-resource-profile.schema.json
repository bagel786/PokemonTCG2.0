{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/resource-envelope-study/schemas/v1/state-panel-resource-profile.schema.json",
  "title": "State-panel resource profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "envelope_id", "budget_mode", "load_condition", "lifecycle",
    "target_cpus", "worker_count", "chunk_iterations", "readiness_timeout_s"
  ],
  "properties": {
    "schema_version": {"const": "state-panel-resource-profile-1.0.0"},
    "envelope_id": {"type": "string", "minLength": 1},
    "budget_mode": {"enum": ["wall_clock", "fixed_work"]},
    "load_condition": {"enum": ["idle", "loaded"]},
    "lifecycle": {"enum": ["fresh", "persistent"]},
    "target_cpus": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "worker_count": {"type": "integer", "minimum": 0},
    "chunk_iterations": {"type": "integer", "minimum": 1},
    "readiness_timeout_s": {"type": "number", "exclusiveMinimum": 0}
  }
}
